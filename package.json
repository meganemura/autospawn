{
  "name": "autospawn",
  "version": "0.3.0",
  "description": "Attach-or-spawn launcher for stdio programs, such as MCP servers, so a secret-resolving wrapper starts once and every client shares it.",
  "type": "module",
  "bin": {
    "autospawn": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "archstrict": "archstrict check",
    "test": "sh scripts/test.sh",
    "mutation": "sh scripts/mutation.sh",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "author": "meganemura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/autospawn.git"
  },
  "bugs": {
    "url": "https://github.com/meganemura/autospawn/issues"
  },
  "homepage": "https://github.com/meganemura/autospawn#readme",
  "devDependencies": {
    "@hegeldev/hegel": "0.4.6",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "24.13.6",
    "archstrict": "0.1.0",
    "finderscope": "0.2.0",
    "stryker-agent-reporter": "0.1.0",
    "typescript": "7.0.2"
  }
}
